+    let task_id = serde_json::to_string(&args.task_id).unwrap_or_else(|_| "\"\"".to_string());
+    let command = serde_json::to_string(&task_state.command).unwrap_or_else(|_| "\"\"".to_string());
+    Ok(boxed_tool_output(FunctionToolOutput::from_text(
