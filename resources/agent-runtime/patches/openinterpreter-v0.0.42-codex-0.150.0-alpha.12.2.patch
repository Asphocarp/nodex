+#[cfg(test)]
+mod tests {
+    use super::*;
+    use crate::runtime::test_support::unique_temp_dir;
+    use codex_utils_absolute_path::test_support::PathExt;
+
+    fn thread_id(suffix: u128) -> ThreadId {
+        ThreadId::from_string(&format!("00000000-0000-0000-0000-{suffix:012}"))
+            .expect("valid thread id")
+    }
+
+    #[tokio::test]
+    async fn multi_agent_v2_completion_outbox_survives_restart_and_is_idempotent() {
+        let home = unique_temp_dir();
+        let sqlite = crate::SqliteConfig::new_for_testing(home.as_path().abs());
+        let runtime = StateRuntime::init(sqlite.clone(), "test-provider".to_string())
+            .await
+            .expect("state runtime");
+        let parent = thread_id(1);
+        let child = thread_id(2);
+        let receipt = "agent_result_child_turn";
+        assert_eq!(
+            runtime
+                .persist_completion_delivery(receipt, parent, child, "turn", "{}")
+                .await
+                .expect("persist"),
+            CompletionDeliveryPersistOutcome::Pending
+        );
+        runtime.close().await;
+
+        let resumed = StateRuntime::init(sqlite, "test-provider".to_string())
+            .await
+            .expect("reopen state runtime");
+        assert_eq!(
+            resumed
+                .list_pending_completion_deliveries(parent, 10)
+                .await
+                .expect("list pending")
+                .len(),
+            1
+        );
+        assert!(
+            resumed
+                .acknowledge_completion_delivery(receipt)
+                .await
+                .expect("acknowledge")
+        );
+        assert_eq!(
+            resumed
+                .persist_completion_delivery(receipt, parent, child, "turn", "different")
+                .await
+                .expect("repeat persist"),
+            CompletionDeliveryPersistOutcome::AlreadyDelivered
+        );
+        assert!(
+            resumed
+                .list_pending_completion_deliveries(parent, 10)
+                .await
+                .expect("list after ack")
+                .is_empty()
+        );
+        assert_eq!(
+            resumed
+                .completion_delivery_counts_for_tests()
+                .await
+                .expect("counts"),
+            (0, 1)
+        );
+    }
+
+    #[tokio::test]
+    async fn multi_agent_v2_completion_receipts_are_payload_bounded_and_gc_is_count_bounded() {
+        let home = unique_temp_dir();
+        let runtime = StateRuntime::init(
+            crate::SqliteConfig::new_for_testing(home.as_path().abs()),
+            "test-provider".to_string(),
+        )
+        .await
+        .expect("state runtime");
+        let parent = thread_id(10);
+        let child = thread_id(11);
+        let oversized = "x".repeat(MAX_COMPLETION_DELIVERY_PAYLOAD_BYTES + 1);
+        assert!(
+            runtime
+                .persist_completion_delivery(
+                    "oversized",
+                    parent,
+                    child,
+                    "turn",
+                    oversized.as_str(),
+                )
+                .await
+                .is_err()
+        );
+
+        let delivered_count = i64::try_from(MAX_DELIVERED_COMPLETION_RECEIPTS + 1)
+            .expect("delivered receipt count should fit i64");
+        sqlx::query(
+            r#"
+WITH RECURSIVE sequence(value) AS (
+    SELECT 1
+    UNION ALL
+    SELECT value + 1 FROM sequence WHERE value < ?
+)
+INSERT INTO multi_agent_completion_outbox (
+    receipt_id, parent_thread_id, child_thread_id, turn_id,
+    communication_json, created_at_ms, updated_at_ms, delivered_at_ms
+)
+SELECT printf('delivered-%05d', value), ?, ?, printf('turn-%05d', value),
+       '{}', ? + value, ? + value, ? + value
+FROM sequence
+            "#,
+        )
+        .bind(delivered_count)
+        .bind(parent.to_string())
+        .bind(child.to_string())
+        .bind(datetime_to_epoch_millis(Utc::now()))
+        .bind(datetime_to_epoch_millis(Utc::now()))
+        .bind(datetime_to_epoch_millis(Utc::now()))
+        .execute(runtime.pool.as_ref())
+        .await
+        .expect("delivered receipts should seed");
+
+        runtime
+            .persist_completion_delivery("pending", parent, child, "turn", "{}")
+            .await
+            .expect("new persist should run receipt GC");
+        assert_eq!(
+            runtime
+                .completion_delivery_counts_for_tests()
+                .await
+                .expect("counts"),
+            (1, MAX_DELIVERED_COMPLETION_RECEIPTS)
+        );
+    }
+}
