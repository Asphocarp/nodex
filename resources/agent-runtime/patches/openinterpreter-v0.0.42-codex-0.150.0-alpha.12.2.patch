+        child_thread_id: ThreadId,
+        turn_id: &str,
+        communication: InterAgentCommunication,
+        context: AgentCommunicationContext,
+    ) -> CodexResult<String> {
+        let Some(store) = self.upgrade()?.agent_graph_store() else {
+            return self
+                .send_completion_to_parent_without_store(parent_thread_id, communication, context)
