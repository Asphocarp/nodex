+fn zcode_task_name(description: &str) -> String {
+    let name = description
+        .chars()
+        .map(|ch| {
+            if ch.is_ascii_alphanumeric() {
+                ch.to_ascii_lowercase()
+            } else {
+                '_'
+            }
+        })
+        .collect::<String>();
+    let name = name.trim_matches('_');
+    if name.is_empty() {
+        "task".to_string()
+    } else {
+        name.to_string()
+    }
+}
