diff --git a/codex-rs/state/src/runtime/completion_deliveries.rs b/codex-rs/state/src/runtime/completion_deliveries.rs
new file mode 100644
index 0000000000000000000000000000000000000000..bb6ae4eb0d0f58af8ef2dda108c6cccbd91e7b96
--- /dev/null
+++ b/codex-rs/state/src/runtime/completion_deliveries.rs
@@ -0,0 +1,335 @@
+use super::*;
+use crate::CompletionDeliveryPersistOutcome;
+use crate::CompletionDeliveryRecord;
+
+/// Completion payloads are intentionally much smaller than the mailbox budget, but keep a hard
+/// storage boundary in case a malformed caller bypasses the formatter.
+pub const MAX_COMPLETION_DELIVERY_PAYLOAD_BYTES: usize = 64 * 1024;
+/// A parent can accumulate completions while unloaded. The cap bounds the state database while
+/// leaving substantially more headroom than one live agent tree can normally produce.
+pub const MAX_PENDING_COMPLETION_DELIVERIES: usize = 4_096;
+/// Delivered rows are retained as idempotency receipts, then compacted by age and count.
+pub const MAX_DELIVERED_COMPLETION_RECEIPTS: usize = 4_096;
+const DELIVERED_RECEIPT_RETENTION_MS: i64 = 7 * 24 * 60 * 60 * 1_000;
+
+impl StateRuntime {
+    /// Persist a completion before any in-memory delivery attempt.
+    ///
+    /// `receipt_id` is both the outbox key and the stable response item ID written to the parent
+    /// rollout. Repeated terminal events therefore converge on one pending or delivered row.
+    pub async fn persist_completion_delivery(
+        &self,
+        receipt_id: &str,
+        parent_thread_id: ThreadId,
+        child_thread_id: ThreadId,
+        turn_id: &str,
+        communication_json: &str,
+    ) -> anyhow::Result<CompletionDeliveryPersistOutcome> {
+        if communication_json.len() > MAX_COMPLETION_DELIVERY_PAYLOAD_BYTES {
+            anyhow::bail!(
+                "completion delivery payload exceeds {} bytes",
+                MAX_COMPLETION_DELIVERY_PAYLOAD_BYTES
+            );
+        }
+
+        let now_ms = datetime_to_epoch_millis(Utc::now());
+        let mut transaction = self.pool.begin().await?;
+        prune_delivered_receipts(&mut transaction, now_ms).await?;
+        let existing = sqlx::query_scalar::<_, Option<i64>>(
+            "SELECT delivered_at_ms FROM multi_agent_completion_outbox WHERE receipt_id = ?",
+        )
+        .bind(receipt_id)
+        .fetch_optional(transaction.as_mut())
+        .await?;
+        if let Some(delivered_at_ms) = existing {
+            transaction.commit().await?;
+            return Ok(if delivered_at_ms.is_some() {
+                CompletionDeliveryPersistOutcome::AlreadyDelivered
+            } else {
+                CompletionDeliveryPersistOutcome::Pending
+            });
+        }
+
+        let pending_count: i64 = sqlx::query_scalar(
+            "SELECT COUNT(*) FROM multi_agent_completion_outbox WHERE delivered_at_ms IS NULL",
+        )
+        .fetch_one(transaction.as_mut())
+        .await?;
+        if pending_count >= i64::try_from(MAX_PENDING_COMPLETION_DELIVERIES)? {
+            anyhow::bail!(
+                "completion delivery outbox is full (maximum {} pending receipts)",
+                MAX_PENDING_COMPLETION_DELIVERIES
+            );
+        }
+
+        sqlx::query(
+            r#"
+INSERT INTO multi_agent_completion_outbox (
+    receipt_id,
+    parent_thread_id,
+    child_thread_id,
+    turn_id,
+    communication_json,
+    created_at_ms,
+    updated_at_ms
+) VALUES (?, ?, ?, ?, ?, ?, ?)
+            "#,
+        )
+        .bind(receipt_id)
+        .bind(parent_thread_id.to_string())
+        .bind(child_thread_id.to_string())
+        .bind(turn_id)
+        .bind(communication_json)
+        .bind(now_ms)
+        .bind(now_ms)
+        .execute(transaction.as_mut())
+        .await?;
+        transaction.commit().await?;
+        Ok(CompletionDeliveryPersistOutcome::Pending)
+    }
+
+    pub async fn list_pending_completion_deliveries(
+        &self,
+        parent_thread_id: ThreadId,
+        limit: usize,
+    ) -> anyhow::Result<Vec<CompletionDeliveryRecord>> {
+        let rows = sqlx::query(
+            r#"
+SELECT receipt_id, parent_thread_id, child_thread_id, turn_id,
+       communication_json, delivery_attempts
+FROM multi_agent_completion_outbox
+WHERE parent_thread_id = ? AND delivered_at_ms IS NULL
+ORDER BY created_at_ms, receipt_id
+LIMIT ?
+            "#,
+        )
+        .bind(parent_thread_id.to_string())
+        .bind(i64::try_from(limit)?)
+        .fetch_all(self.pool.as_ref())
+        .await?;
+        rows.iter()
+            .map(CompletionDeliveryRecord::try_from_row)
+            .collect()
+    }
+
+    /// Acknowledge only after the stable response item has reached the parent rollout.
+    pub async fn acknowledge_completion_delivery(&self, receipt_id: &str) -> anyhow::Result<bool> {
+        let now_ms = datetime_to_epoch_millis(Utc::now());
+        let result = sqlx::query(
+            r#"
+UPDATE multi_agent_completion_outbox
+SET delivered_at_ms = COALESCE(delivered_at_ms, ?), updated_at_ms = ?, last_error = NULL
+WHERE receipt_id = ?
+            "#,
+        )
+        .bind(now_ms)
+        .bind(now_ms)
+        .bind(receipt_id)
+        .execute(self.pool.as_ref())
+        .await?;
+        Ok(result.rows_affected() > 0)
+    }
+
+    pub async fn record_completion_delivery_attempt(
+        &self,
+        receipt_id: &str,
+        error: Option<&str>,
+    ) -> anyhow::Result<()> {
+        sqlx::query(
+            r#"
+UPDATE multi_agent_completion_outbox
+SET delivery_attempts = delivery_attempts + 1, updated_at_ms = ?, last_error = ?
+WHERE receipt_id = ? AND delivered_at_ms IS NULL
+            "#,
+        )
+        .bind(datetime_to_epoch_millis(Utc::now()))
+        .bind(error)
+        .bind(receipt_id)
+        .execute(self.pool.as_ref())
+        .await?;
+        Ok(())
+    }
+
+    #[cfg(test)]
+    pub(crate) async fn completion_delivery_counts_for_tests(
+        &self,
+    ) -> anyhow::Result<(usize, usize)> {
+        let (pending, delivered): (i64, i64) = sqlx::query_as(
+            r#"
+SELECT
+    SUM(CASE WHEN delivered_at_ms IS NULL THEN 1 ELSE 0 END),
+    SUM(CASE WHEN delivered_at_ms IS NOT NULL THEN 1 ELSE 0 END)
+FROM multi_agent_completion_outbox
+            "#,
+        )
+        .fetch_one(self.pool.as_ref())
+        .await?;
+        Ok((usize::try_from(pending)?, usize::try_from(delivered)?))
+    }
+}
+
+async fn prune_delivered_receipts(
+    transaction: &mut sqlx::Transaction<'_, Sqlite>,
+    now_ms: i64,
+) -> anyhow::Result<()> {
+    sqlx::query(
+        "DELETE FROM multi_agent_completion_outbox WHERE delivered_at_ms IS NOT NULL AND delivered_at_ms < ?",
+    )
+    .bind(now_ms.saturating_sub(DELIVERED_RECEIPT_RETENTION_MS))
+    .execute(transaction.as_mut())
+    .await?;
+    sqlx::query(
+        r#"
+DELETE FROM multi_agent_completion_outbox
+WHERE delivered_at_ms IS NOT NULL
+  AND receipt_id NOT IN (
+      SELECT receipt_id
+      FROM multi_agent_completion_outbox
+      WHERE delivered_at_ms IS NOT NULL
+      ORDER BY delivered_at_ms DESC, receipt_id DESC
+      LIMIT ?
+  )
+        "#,
+    )
+    .bind(i64::try_from(MAX_DELIVERED_COMPLETION_RECEIPTS)?)
