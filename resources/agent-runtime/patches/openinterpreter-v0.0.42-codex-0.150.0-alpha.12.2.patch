+    .expect("durable completion replay should outlive the old retry window");
+    let replayed = parent_thread
+        .session
+        .input_queue
+        .drain_mailbox_input_items()
+        .await
+        .0;
+    assert_eq!(replayed.len(), 1);
+    let crate::session::TurnInput::InterAgentCommunication(replayed) = &replayed[0] else {
+        panic!("expected completion communication");
