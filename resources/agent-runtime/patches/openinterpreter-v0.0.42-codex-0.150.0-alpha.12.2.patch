+const COMPLETION_RECEIPT_ID_PREFIX: &str = "amsg_agent_result_";
+const COMPLETION_RECEIPT_HASH_HEX_LEN: usize = 46;
+
+/// Derive the stable response item ID used to make completion delivery idempotent.
+///
+/// Responses API AgentMessage IDs must begin with `amsg` and are capped at 64 characters. Hashing
+/// the durable delivery key keeps UUID-sized child and turn IDs within that boundary while
+/// retaining 184 bits of collision resistance and deterministic replay across process restarts.
+fn completion_receipt_id(child_thread_id: ThreadId, turn_id: &str) -> String {
+    let mut hasher = Sha256::new();
+    hasher.update(b"codex.agent-completion.receipt.v1");
+    hasher.update([0]);
+    hasher.update(child_thread_id.to_string().as_bytes());
+    hasher.update([0]);
+    hasher.update(turn_id.as_bytes());
+    let digest = format!("{:x}", hasher.finalize());
+    format!(
+        "{COMPLETION_RECEIPT_ID_PREFIX}{}",
+        &digest[..COMPLETION_RECEIPT_HASH_HEX_LEN]
+    )
+}
+
+pub(crate) fn is_completion_receipt_id(receipt_id: &str) -> bool {
+    receipt_id.starts_with(COMPLETION_RECEIPT_ID_PREFIX)
+}
