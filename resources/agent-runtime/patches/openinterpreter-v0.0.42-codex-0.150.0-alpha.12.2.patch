+    fn reads_session_import_in_one_pass() {
+        let root = TempDir::new().expect("tempdir");
+        let path = root.path().join("session.jsonl");
+        let contents = [
+            serde_json::json!({
+                "type": "user",
+                "cwd": root.path(),
