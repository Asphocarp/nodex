+#[cfg(test)]
+pub(crate) fn build_request(
+    prompt: &Prompt,
+    model_info: &ModelInfo,
+    effort: Option<ReasoningEffortConfig>,
+    session_id: &str,
+    session_source: Option<&SessionSource>,
+) -> Result<AnthropicMessageRequest, serde_json::Error> {
+    build_request_for_profile(
+        prompt,
+        model_info,
+        effort,
+        session_id,
+        session_source,
