+        let ResponseItem::FunctionCall {
+            name,
+            arguments,
+            call_id,
+            ..
+        } = item
+        else {
+            return None;
+        };
+        if name != "TodoWrite" || call_id == current_call_id {
+            return None;
+        }
+        serde_json::from_str::<ZCodeTodoWriteArgs>(arguments)
