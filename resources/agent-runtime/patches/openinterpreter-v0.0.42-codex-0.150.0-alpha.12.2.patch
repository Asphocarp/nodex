+
+async fn drain_replayed_completion(
+    parent_thread: &Arc<CodexThread>,
+    receipt_id: &str,
+) -> InterAgentCommunication {
+    timeout(Duration::from_secs(2), async {
+        while !parent_thread
+            .session
+            .input_queue
+            .has_pending_mailbox_items()
+            .await
+        {
+            sleep(Duration::from_millis(10)).await;
+        }
+    })
+    .await
+    .expect("pending outbox should replay after parent resume");
+    let replayed = parent_thread
+        .session
+        .input_queue
+        .drain_mailbox_input_items()
+        .await
+        .0;
+    let [crate::session::TurnInput::InterAgentCommunication(communication)] = replayed.as_slice()
+    else {
+        panic!("expected exactly one replayed completion");
+    };
+    assert_eq!(
+        communication
+            .id
+            .as_ref()
+            .map(ToString::to_string)
+            .as_deref(),
+        Some(receipt_id)
+    );
+    communication.clone()
+}
