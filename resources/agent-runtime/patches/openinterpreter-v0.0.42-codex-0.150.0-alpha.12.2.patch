+    pub(crate) async fn completion_receipt_in_memory(&self, receipt_id: &str) -> bool {
+        self.clone_history().await.raw_items().any(|item| {
+            item.id()
+                .is_some_and(|item_id| item_id.as_str() == receipt_id)
+        })
+    }
+
+    /// Retries a completion write without recording another model-history or UI item.
+    ///
+    /// The first durability barrier handles the case where append succeeded but its later flush
+    /// failed. Only a missing receipt after that barrier permits another append.
+    pub(crate) async fn retry_completion_receipt_persistence(
+        &self,
+        communication: &InterAgentCommunication,
+    ) -> anyhow::Result<bool> {
+        let _guard = self.completion_persistence_lock.lock().await;
+        let Some(receipt_id) = communication.id.as_ref() else {
+            return Ok(false);
+        };
+        if self
+            .completion_receipt_is_durable(receipt_id.as_str())
+            .await?
+        {
+            return Ok(true);
+        }
+        let response_item = self
+            .clone_history()
+            .await
+            .raw_items()
+            .find(|item| {
+                item.id()
+                    .is_some_and(|item_id| item_id.as_str() == receipt_id.as_str())
+            })
+            .cloned();
+        let Some(response_item) = response_item else {
+            return Ok(false);
+        };
+        let rollout_items = [
+            RolloutItem::InterAgentCommunicationMetadata {
+                trigger_turn: communication.trigger_turn,
+            },
+            RolloutItem::ResponseItem(response_item.into()),
+        ];
+        self.persist_completion_receipt_locked(communication, &rollout_items)
+            .await
+    }
+
+    async fn persist_completion_receipt(
+        &self,
+        communication: &InterAgentCommunication,
+        rollout_items: &[RolloutItem],
+    ) -> anyhow::Result<bool> {
+        let _guard = self.completion_persistence_lock.lock().await;
+        self.persist_completion_receipt_locked(communication, rollout_items)
+            .await
+    }
+
+    async fn persist_completion_receipt_locked(
+        &self,
+        communication: &InterAgentCommunication,
+        rollout_items: &[RolloutItem],
+    ) -> anyhow::Result<bool> {
+        let Some(receipt_id) = communication.id.as_ref() else {
+            return Ok(false);
+        };
+        if self
+            .completion_receipt_is_durable(receipt_id.as_str())
+            .await?
+        {
+            return Ok(true);
+        }
+        let Some(live_thread) = self.live_thread() else {
+            return Ok(false);
+        };
+        live_thread.append_items(rollout_items).await?;
+        self.completion_receipt_is_durable(receipt_id.as_str())
+            .await
+    }
+
+    /// A completion can be acknowledged only after a successful durability barrier and a read
+    /// from the persistence backend. Local sessions inspect the rollout itself rather than the
+    /// in-memory conversation projection.
+    pub(crate) async fn completion_receipt_is_durable(
+        &self,
+        receipt_id: &str,
+    ) -> anyhow::Result<bool> {
+        let Some(live_thread) = self.live_thread() else {
+            return Ok(false);
+        };
+        live_thread.flush().await?;
+        let items = if let Some(path) = live_thread.local_rollout_path().await? {
+            if !path.exists() {
+                return Ok(false);
+            }
+            let (items, _, parse_errors) = RolloutRecorder::load_rollout_items(&path).await?;
+            if parse_errors != 0 {
+                anyhow::bail!("rollout contains {parse_errors} parse errors");
+            }
+            items
+        } else {
+            live_thread
+                .load_history(/*include_archived*/ true)
+                .await?
+                .items
+        };
+        Ok(items.iter().any(|item| match item {
+            RolloutItem::ResponseItem(item) => item
+                .id()
+                .is_some_and(|item_id| item_id.as_str() == receipt_id),
+            _ => false,
+        }))
+    }
