+        parent_thread_id: ThreadId,
+        communication: InterAgentCommunication,
+        context: AgentCommunicationContext,
+    ) -> CodexResult<String> {
+        let mut last_error = None;
+        for attempt in 1..=Self::COMPLETION_DELIVERY_MAX_ATTEMPTS {
+            match self
+                .send_inter_agent_communication(
+                    parent_thread_id,
+                    communication.clone(),
+                    context.clone(),
+                    TurnStartOptions::default(),
+                )
+                .await
+            {
+                Ok(communication_id) => return Ok(communication_id),
+                Err(err) => {
+                    let terminal = attempt == Self::COMPLETION_DELIVERY_MAX_ATTEMPTS;
+                    let reason = match err.details() {
+                        CodexErrorDetails::MailboxCapacityExceeded { .. } => "mailbox_capacity",
+                        CodexErrorDetails::ThreadNotFound(_) => "parent_not_loaded",
+                        CodexErrorDetails::InternalAgentDied => "parent_runtime_terminated",
+                        _ => "other",
+                    };
+                    warn!(
+                        error = %err,
+                        parent_thread_id = %parent_thread_id,
+                        attempt,
+                        terminal,
+                        "failed to deliver subagent completion to parent"
+                    );
+                    if let Some(metrics) = codex_otel::global() {
+                        let terminal_tag = if terminal { "true" } else { "false" };
+                        let _ = metrics.counter(
+                            "codex.multi_agent.completion_delivery_failure",
+                            /*inc*/ 1,
+                            &[("reason", reason), ("terminal", terminal_tag)],
+                        );
+                    }
+                    last_error = Some(err);
+                    if !terminal {
+                        let delay_ms = 25_u64.saturating_mul(4_u64.pow((attempt - 1) as u32));
+                        sleep(Duration::from_millis(delay_ms)).await;
