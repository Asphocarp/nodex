+        save_token(temp_dir.path(), test_token()).expect("save token");
+
+        assert_eq!(
+            std::fs::read(&outside).expect("read target"),
+            b"do not replace"
+        );
+        assert_eq!(
+            load_token(temp_dir.path()).expect("load token"),
+            test_token()
+        );
+    }
+}
