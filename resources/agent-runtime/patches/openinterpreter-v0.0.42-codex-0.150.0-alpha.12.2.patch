+    record_zcode_todos(&invocation, &args.todos);
+    let summary = zcode_todo_summary(&args.todos);
+    Ok(boxed_tool_output(FunctionToolOutput::from_text(
+        serde_json::to_string(&ZCodeTodoWriteOutput {
+            old_todos,
+            todos: args.todos,
+            summary,
+        })
+        .unwrap_or_else(|_| "{}".to_string()),
+        Some(true),
+    )))
