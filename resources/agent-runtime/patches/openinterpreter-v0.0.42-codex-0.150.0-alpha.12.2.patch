+    let parent_thread_id = session.thread_id();
+    let spawn_source = thread_spawn_source(
+        parent_thread_id,
+        &turn.session_source,
+        child_depth,
+        Some(role_name),
+        Some(task_name),
+    )?;
+    let started_at = Instant::now();
+    let spawned = Box::pin(session.services.agent_control.spawn_agent_with_metadata(
+        config,
+        vec![UserInput::Text {
+            text: args.prompt,
+            text_elements: Vec::new(),
