+    ON multi_agent_completion_outbox(parent_thread_id, created_at_ms, receipt_id)
+    WHERE delivered_at_ms IS NULL;
+
+CREATE INDEX idx_multi_agent_completion_outbox_delivered
+    ON multi_agent_completion_outbox(delivered_at_ms, receipt_id)
+    WHERE delivered_at_ms IS NOT NULL;
