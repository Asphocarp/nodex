+                ),
+                Default::default(),
+            )
+            .await
+            .expect("test mailbox should fill to its count limit");
+    }
+
+    let parent_for_drain = Arc::clone(&parent_thread);
+    let drain = tokio::spawn(async move {
+        sleep(Duration::from_millis(750)).await;
+        parent_for_drain
+            .session
+            .input_queue
+            .drain_mailbox_input_items()
+            .await
+    });
+    let communication = InterAgentCommunication::new(
+        child_path,
+        AgentPath::root(),
