+fn tool(name: &str, description: &str, mut parameters: Value) -> Value {
+    if let Value::Object(map) = &mut parameters {
+        map.insert(
+            "$schema".to_string(),
+            json!("https://json-schema.org/draft/2020-12/schema"),
+        );
+    }
+    json!({
+        "type": "function",
+        "function": {
+            "name": name,
+            "description": description,
+            "parameters": parameters,
+        }
+    })
+}
