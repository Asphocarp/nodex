+    pub(crate) async fn ensure_completion_replay_worker(&self, parent_thread_id: ThreadId) {
+        {
+            let mut active = self.completion_replay_parents.lock().await;
+            if !active.insert(parent_thread_id) {
+                return;
+            }
+        }
+        let control = self.clone();
+        tokio::spawn(async move {
+            let mut delay = Duration::from_millis(250);
+            loop {
+                sleep(delay).await;
+                let Some(store) = control
+                    .upgrade()
+                    .ok()
+                    .and_then(|state| state.agent_graph_store())
+                else {
+                    break;
+                };
+                let deliveries = match store
+                    .list_pending_completion_deliveries(
+                        parent_thread_id,
+                        Self::COMPLETION_REPLAY_PAGE_SIZE,
+                    )
+                    .await
+                {
+                    Ok(deliveries) => deliveries,
+                    Err(err) => {
+                        warn!(%parent_thread_id, %err, "failed to reload completion outbox");
+                        delay = (delay * 2).min(Self::COMPLETION_REPLAY_MAX_DELAY);
+                        continue;
+                    }
+                };
+                if deliveries.is_empty() {
+                    // Close the worker-exit race with a new outbox insert. An inserter cannot
+                    // observe this parent as active after the confirming read removes it.
+                    let mut active = control.completion_replay_parents.lock().await;
+                    match store
+                        .list_pending_completion_deliveries(parent_thread_id, 1)
+                        .await
+                    {
+                        Ok(deliveries) if deliveries.is_empty() => {
+                            active.remove(&parent_thread_id);
+                            return;
+                        }
+                        Ok(_) => {}
+                        Err(err) => {
+                            warn!(%parent_thread_id, %err, "failed to confirm empty completion outbox");
+                        }
+                    }
+                    drop(active);
+                    delay = (delay * 2).min(Self::COMPLETION_REPLAY_MAX_DELAY);
+                    continue;
+                }
+                for delivery in deliveries {
+                    let _ = control.try_replay_completion_delivery(&delivery).await;
+                }
+                delay = (delay * 2).min(Self::COMPLETION_REPLAY_MAX_DELAY);
+            }
+            control
+                .completion_replay_parents
+                .lock()
+                .await
+                .remove(&parent_thread_id);
+        });
+    }
