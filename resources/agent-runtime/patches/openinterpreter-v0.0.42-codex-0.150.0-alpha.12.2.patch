+            exec: ValidExec::new(
+                "head",
+                vec![MatchedArg::new(
+                    /*index*/ 0,
+                    ArgType::ReadableFile,
+                    "src/extension.ts"
+                )?],
+                &["/bin/head", "/usr/bin/head"]
+            )
+        }),
+        policy.check(&head)
