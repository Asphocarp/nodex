+                content,
+                summary,
+                encrypted_content,
+                ..
+            } => {
+                flush_pending_tool_results(
+                    &mut messages,
+                    &mut pending_tool_results,
+                    &tool_names_by_call_id,
+                    &mut todo_reminder,
+                );
+                let thinking = content
+                    .iter()
+                    .flatten()
+                    .map(|entry| match entry {
