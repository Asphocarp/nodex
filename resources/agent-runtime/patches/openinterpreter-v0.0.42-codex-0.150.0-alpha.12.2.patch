@@ -0,0 +1,35 @@
+use anyhow::Result;
+use codex_protocol::ThreadId;
+use sqlx::Row;
+use sqlx::sqlite::SqliteRow;
+
+/// One durable child-completion delivery waiting for acknowledgement from its parent rollout.
+#[derive(Clone, Debug, PartialEq, Eq)]
+pub struct CompletionDeliveryRecord {
+    pub receipt_id: String,
+    pub parent_thread_id: ThreadId,
+    pub child_thread_id: ThreadId,
+    pub turn_id: String,
+    pub communication_json: String,
+    pub delivery_attempts: u32,
+}
+
+impl CompletionDeliveryRecord {
+    pub(crate) fn try_from_row(row: &SqliteRow) -> Result<Self> {
+        Ok(Self {
+            receipt_id: row.try_get("receipt_id")?,
+            parent_thread_id: ThreadId::try_from(row.try_get::<String, _>("parent_thread_id")?)?,
+            child_thread_id: ThreadId::try_from(row.try_get::<String, _>("child_thread_id")?)?,
+            turn_id: row.try_get("turn_id")?,
+            communication_json: row.try_get("communication_json")?,
+            delivery_attempts: u32::try_from(row.try_get::<i64, _>("delivery_attempts")?)?,
+        })
+    }
+}
+
+/// Result of idempotently persisting a completion receipt.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum CompletionDeliveryPersistOutcome {
+    Pending,
+    AlreadyDelivered,
+}
