+                        CompletionDeliveryPersistOutcome::Pending
+                    }
+                    codex_state::CompletionDeliveryPersistOutcome::AlreadyDelivered => {
+                        CompletionDeliveryPersistOutcome::AlreadyDelivered
+                    }
+                })
