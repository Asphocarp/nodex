+            .trim();
+        key != "features.default_mode_request_user_input"
+    }) {
+        config_overrides
+            .raw_overrides
+            .push(DEFAULT_MODE_REQUEST_USER_INPUT_OVERRIDE.to_string());
+    }
+}
