+
+    fn list_pending_completion_deliveries(
+        &self,
+        parent_thread_id: ThreadId,
+        limit: usize,
+    ) -> AgentGraphStoreFuture<'_, Vec<DurableCompletionDelivery>> {
+        Box::pin(async move {
+            self.state_db
+                .list_pending_completion_deliveries(parent_thread_id, limit)
+                .await
+                .map(|deliveries| {
+                    deliveries
