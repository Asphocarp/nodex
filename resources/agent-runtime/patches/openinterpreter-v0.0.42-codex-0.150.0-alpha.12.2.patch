+    Ok(boxed_tool_output(FunctionToolOutput::from_text(
+        format!(
+            "agent_id: {}\nactual_subagent_type: {role_name}\nstatus: completed\n\n[summary]\n{result}",
+            spawned.thread_id
+        ),
+        Some(true),
+    )))
