+        .and_then(Value::as_i64)
+        .unwrap_or_default();
+    TokenUsage {
+        input_tokens,
+        cached_input_tokens,
+        cache_write_input_tokens: 0,
+        output_tokens,
+        reasoning_output_tokens: 0,
