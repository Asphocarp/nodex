import { lstatSync } from "node:fs";
import path from "node:path";

import Database from "better-sqlite3";

const SUPPORTED_SOURCE_VERSIONS = new Set([26, 57, 68, 82, 83]);

const parseHome = (argv: readonly string[]): string => {
  if (argv.length !== 2 || argv[0] !== "--home" || !argv[1]) {
    throw new Error("usage: legacy-profile-migrator --home <absolute-staging-home>");
  }
  if (!path.isAbsolute(argv[1])) {
    throw new Error("Legacy migration staging home must be absolute");
  }
  const home = path.normalize(argv[1]);
  const metadata = lstatSync(home);
  if (!metadata.isDirectory() || metadata.isSymbolicLink()) {
    throw new Error("Legacy migration staging home must be a real directory");
  }
  return home;
};

const readVersion = (databasePath: string): number => {
  const database = new Database(databasePath, {
    readonly: true,
    fileMustExist: true,
  });
  try {
    return database.pragma("user_version", { simple: true }) as number;
  } finally {
    database.close();
  }
};

const canonicalizeV84Schema = (databasePath: string): void => {
  const database = new Database(databasePath);
  try {
    const tableSql = database
      .prepare(
        "SELECT sql FROM sqlite_schema WHERE type = 'table' AND name = 'nodex_agent_call_receipts'",
      )
      .pluck()
      .get() as string | undefined;
    if (
      !tableSql ||
      tableSql.includes(
        "CHECK (turn_id IS NULL OR length(trim(turn_id)) BETWEEN 1 AND 512)",
      )
    ) {
      return;
    }
    database.exec(`
      BEGIN IMMEDIATE;
      DROP TRIGGER IF EXISTS nodex_agent_call_receipts_validate_update;
      DROP TRIGGER IF EXISTS nodex_agent_committed_call_receipts_cannot_delete;
      ALTER TABLE nodex_agent_call_receipts RENAME TO nodex_agent_call_receipts_legacy;
      CREATE TABLE nodex_agent_call_receipts (
        call_identity TEXT PRIMARY KEY,
        thread_id TEXT NOT NULL,
        turn_id TEXT,
        call_id TEXT NOT NULL,
        project_id TEXT NOT NULL REFERENCES projects(id) ON DELETE CASCADE,
        tool TEXT NOT NULL,
        request_hash TEXT NOT NULL,
        mutation_id TEXT NOT NULL UNIQUE,
        authority_fingerprint TEXT,
        provenance_version INTEGER,
        allocations_json TEXT NOT NULL DEFAULT '[]',
        result_metadata_json TEXT NOT NULL DEFAULT '{}',
        status TEXT NOT NULL DEFAULT 'prepared',
        created_at TEXT NOT NULL,
        updated_at TEXT NOT NULL,
        UNIQUE (thread_id, call_id),
        CHECK (length(call_identity) = 64),
        CHECK (length(trim(thread_id)) BETWEEN 1 AND 512),
        CHECK (turn_id IS NULL OR length(trim(turn_id)) BETWEEN 1 AND 512),
        CHECK (length(trim(call_id)) BETWEEN 1 AND 512),
        CHECK (length(trim(tool)) BETWEEN 1 AND 128),
        CHECK (length(request_hash) = 64),
        CHECK (length(trim(mutation_id)) BETWEEN 1 AND 512),
        CHECK (
          (turn_id IS NULL AND authority_fingerprint IS NULL AND provenance_version IS NULL)
          OR (
            turn_id IS NOT NULL
            AND authority_fingerprint IS NOT NULL
            AND provenance_version IS NOT NULL
            AND length(trim(turn_id)) BETWEEN 1 AND 512
            AND length(authority_fingerprint) = 64
            AND provenance_version = 1
          )
        ),
        CHECK (json_valid(allocations_json) AND json_type(allocations_json) = 'array'),
        CHECK (json_valid(result_metadata_json) AND json_type(result_metadata_json) = 'object'),
        CHECK (status IN ('prepared', 'committed'))
      ) WITHOUT ROWID;
      INSERT INTO nodex_agent_call_receipts
      SELECT * FROM nodex_agent_call_receipts_legacy;
      DROP TABLE nodex_agent_call_receipts_legacy;
      CREATE TRIGGER nodex_agent_call_receipts_validate_update
      BEFORE UPDATE ON nodex_agent_call_receipts
      WHEN OLD.status = 'committed'
        OR NEW.call_identity IS NOT OLD.call_identity
        OR NEW.thread_id IS NOT OLD.thread_id
        OR NEW.turn_id IS NOT OLD.turn_id
        OR NEW.call_id IS NOT OLD.call_id
        OR NEW.project_id IS NOT OLD.project_id
        OR NEW.tool IS NOT OLD.tool
        OR NEW.request_hash IS NOT OLD.request_hash
        OR NEW.mutation_id IS NOT OLD.mutation_id
        OR NEW.authority_fingerprint IS NOT OLD.authority_fingerprint
        OR NEW.provenance_version IS NOT OLD.provenance_version
        OR NEW.created_at IS NOT OLD.created_at
        OR (OLD.status = 'prepared' AND NEW.status NOT IN ('prepared', 'committed'))
      BEGIN
        SELECT RAISE(ABORT, 'Nodex Agent call receipt identity is immutable');
      END;
      CREATE TRIGGER nodex_agent_committed_call_receipts_cannot_delete
      BEFORE DELETE ON nodex_agent_call_receipts
      WHEN OLD.status = 'committed'
      BEGIN
        SELECT RAISE(ABORT, 'Committed Nodex Agent call receipts are immutable');
      END;
      COMMIT;
    `);
  } finally {
    database.close();
  }
};

const home = parseHome(process.argv.slice(2));
const databasePath = path.join(home, "nodex.db");
const sourceVersion = readVersion(databasePath);
if (!SUPPORTED_SOURCE_VERSIONS.has(sourceVersion)) {
  throw new Error(`Unsupported legacy Nodex schema v${sourceVersion}`);
}

process.env.NODEX_HOME = home;
process.stderr.write(`nodex legacy migration: importing v${sourceVersion}\n`);

const [{ ensureDatabase }, { migrateShippedSchemaStoreToCurrent }] = await Promise.all([
  import("./legacy-source/src/main/local-store/schema"),
  import("./legacy-source/src/main/local-store/shipped-schema-migration"),
]);

if (sourceVersion === 26 || sourceVersion === 57) {
  await migrateShippedSchemaStoreToCurrent({ nodexHome: home, databasePath });
}
ensureDatabase();
canonicalizeV84Schema(databasePath);

const installedVersion = readVersion(databasePath);
if (installedVersion !== 84) {
  throw new Error(`Legacy migration published v${installedVersion}, expected v84`);
}
process.stderr.write(`nodex legacy migration: staged v${sourceVersion} as v84\n`);
