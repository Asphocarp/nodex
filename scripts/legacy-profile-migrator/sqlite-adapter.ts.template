import { existsSync } from "node:fs";
import { backup, DatabaseSync, type StatementSync } from "node:sqlite";

type TransactionMode = "DEFERRED" | "IMMEDIATE" | "EXCLUSIVE";

class LegacyStatement {
  readonly #statement: StatementSync;
  readonly #sql: string;
  #pluck = false;

  constructor(statement: StatementSync, sql: string) {
    this.#statement = statement;
    this.#sql = sql;
  }

  get readonly(): boolean {
    return /^\s*(?:SELECT|WITH|PRAGMA|EXPLAIN)\b/iu.test(this.#sql);
  }

  run(...parameters: unknown[]): ReturnType<StatementSync["run"]> {
    return this.#statement.run(...parameters);
  }

  get(...parameters: unknown[]): unknown {
    const row = this.#statement.get(...parameters);
    return this.#pluck ? firstValue(row) : row;
  }

  all(...parameters: unknown[]): unknown[] {
    const rows = this.#statement.all(...parameters);
    return this.#pluck ? rows.map(firstValue) : rows;
  }

  *iterate(...parameters: unknown[]): IterableIterator<unknown> {
    for (const row of this.#statement.iterate(...parameters)) {
      yield this.#pluck ? firstValue(row) : row;
    }
  }

  columns(): ReturnType<StatementSync["columns"]> {
    return this.#statement.columns();
  }

  pluck(enabled = true): this {
    this.#pluck = enabled;
    return this;
  }
}

const firstValue = (row: unknown): unknown => {
  if (!row || typeof row !== "object") return undefined;
  return Object.values(row as Record<string, unknown>)[0];
};

interface LegacyDatabaseOptions {
  readonly readonly?: boolean;
  readonly fileMustExist?: boolean;
  readonly timeout?: number;
}

type TransactionFunction<TArgs extends unknown[], TResult> =
  ((...args: TArgs) => TResult) & {
    deferred: (...args: TArgs) => TResult;
    immediate: (...args: TArgs) => TResult;
    exclusive: (...args: TArgs) => TResult;
  };

export default class LegacyDatabase {
  readonly #database: DatabaseSync;
  #transactionDepth = 0;
  #savepointId = 0;

  constructor(databasePath: string, options: LegacyDatabaseOptions = {}) {
    if (options.fileMustExist && !existsSync(databasePath)) {
      throw new Error(`Database file does not exist: ${databasePath}`);
    }
    this.#database = new DatabaseSync(databasePath, {
      readOnly: options.readonly ?? false,
      timeout: options.timeout ?? 0,
      defensive: false,
      enableDoubleQuotedStringLiterals: true,
      enableForeignKeyConstraints: false,
    });
  }

  get inTransaction(): boolean {
    return this.#transactionDepth > 0;
  }

  prepare(sql: string): LegacyStatement {
    return new LegacyStatement(this.#database.prepare(sql), sql);
  }

  exec(sql: string): this {
    this.#database.exec(sql);
    return this;
  }

  pragma(sql: string, options: { readonly simple?: boolean } = {}): unknown {
    const rows = this.#database.prepare(`PRAGMA ${sql}`).all();
    return options.simple ? firstValue(rows[0]) : rows;
  }

  transaction<TArgs extends unknown[], TResult>(
    callback: (...args: TArgs) => TResult,
  ): TransactionFunction<TArgs, TResult> {
    const run = (mode: TransactionMode, args: TArgs): TResult =>
      this.#runTransaction(mode, callback, args);
    const transaction = ((...args: TArgs) =>
      run("DEFERRED", args)) as TransactionFunction<TArgs, TResult>;
    transaction.deferred = (...args) => run("DEFERRED", args);
    transaction.immediate = (...args) => run("IMMEDIATE", args);
    transaction.exclusive = (...args) => run("EXCLUSIVE", args);
    return transaction;
  }

  backup(destinationPath: string): Promise<number> {
    return backup(this.#database, destinationPath);
  }

  close(): void {
    this.#database.close();
  }

  #runTransaction<TArgs extends unknown[], TResult>(
    mode: TransactionMode,
    callback: (...args: TArgs) => TResult,
    args: TArgs,
  ): TResult {
    if (this.#transactionDepth > 0) {
      const savepoint = `legacy_nested_${this.#savepointId++}`;
      this.#database.exec(`SAVEPOINT ${savepoint}`);
      this.#transactionDepth += 1;
      try {
        const result = callback(...args);
        this.#database.exec(`RELEASE SAVEPOINT ${savepoint}`);
        return result;
      } catch (error) {
        this.#database.exec(`ROLLBACK TO SAVEPOINT ${savepoint}`);
        this.#database.exec(`RELEASE SAVEPOINT ${savepoint}`);
        throw error;
      } finally {
        this.#transactionDepth -= 1;
      }
    }

    this.#database.exec(`BEGIN ${mode}`);
    this.#transactionDepth = 1;
    try {
      const result = callback(...args);
      this.#database.exec("COMMIT");
      return result;
    } catch (error) {
      this.#database.exec("ROLLBACK");
      throw error;
    } finally {
      this.#transactionDepth = 0;
    }
  }
}

export namespace LegacyDatabase {
  export type Database = LegacyDatabase;
}
