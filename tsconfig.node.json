{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "noEmit": true,
    "incremental": true,
    "tsBuildInfoFile": ".cache/typescript/node.tsbuildinfo",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "electron-vite/node"
    ]
  },
  "include": [
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "scripts/**/*.ts",
    "electron.vite.config.ts",
    "packages/codex-app-server-protocol/**/*.ts",
    "packages/core-protocol/**/*.ts",
  ],
  "exclude": [
    "scripts/**/*.test.ts"
  ]
}
