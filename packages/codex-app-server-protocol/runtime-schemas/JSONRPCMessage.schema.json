      "type": "object"
    },
    "definitions__v2__RequestId": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "format": "int64",
          "type": "integer"
        }
      ]
    },
    "definitions__W3cTraceContext": {
      "properties": {
        "traceparent": {
          "type": [
            "string",
            "null"
          ]
        },
        "tracestate": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "type": "object"
    }
  },
  "description": "Refers to any valid JSON-RPC object that can be decoded off the wire, or encoded to be sent.",
  "title": "JSONRPCMessage"
