        "id": {
          "$ref": "#/definitions/definitions__v2__RequestId"
        },
        "method": {
          "type": "string"
        },
        "params": true,
        "trace": {
          "anyOf": [
            {
              "$ref": "#/definitions/definitions__W3cTraceContext"
            },
            {
              "type": "null"
            }
          ],
          "description": "Optional W3C Trace Context for distributed tracing."
        }
      },
      "required": [
        "id",
        "method"
      ],
      "title": "JSONRPCRequest",
      "type": "object"
    },
    "definitions__JSONRPCResponse": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "A successful (non-error) response to a request.",
      "properties": {
        "id": {
          "$ref": "#/definitions/definitions__v2__RequestId"
        },
        "result": true
      },
      "required": [
        "id",
        "result"
      ],
