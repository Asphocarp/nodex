    }
  ],
  "definitions": {
    "definitions__JSONRPCError": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "A response to a request that indicates an error occurred.",
      "properties": {
        "error": {
          "$ref": "#/definitions/definitions__JSONRPCErrorError"
        },
        "id": {
          "$ref": "#/definitions/definitions__v2__RequestId"
        }
      },
      "required": [
        "error",
        "id"
      ],
      "title": "JSONRPCError",
      "type": "object"
    },
    "definitions__JSONRPCErrorError": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "properties": {
        "code": {
          "format": "int64",
          "type": "integer"
        },
        "data": true,
        "message": {
          "type": "string"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "JSONRPCErrorError",
      "type": "object"
    },
    "definitions__JSONRPCNotification": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "A notification which does not expect a response.",
      "properties": {
        "method": {
          "type": "string"
        },
        "params": true
      },
      "required": [
        "method"
      ],
      "title": "JSONRPCNotification",
      "type": "object"
    },
    "definitions__JSONRPCRequest": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "description": "A request that expects a response.",
