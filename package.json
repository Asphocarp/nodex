{
  "name": "nodex",
  "version": "0.1.10",
  "description": "Block-based Agent Orchestrator",
  "license": "MIT",
  "private": false,
  "packageManager": "pnpm@11.11.0",
  "workspaces": [
    "packages/*",
    "third_party/blocknote/packages/*"
  ],
  "main": "out/main/bootstrap.js",
  "bin": {
    "nodex": "./bin/nodex.mjs"
  },
  "files": [
    "bin",
    "out",
    "src",
    "electron.vite.config.ts",
    "tsconfig.json"
  ],
  "scripts": {
    "test": "pnpm run test:unit && pnpm run test:main && pnpm run test:renderer && pnpm run test:integration",
    "test:unit": "vitest run --config vitest.node.config.ts",
    "test:main": "node scripts/run-vitest-in-electron.mjs --config vitest.main.config.ts",
    "test:renderer": "vitest run --config vitest.renderer.config.ts",
    "test:browser": "vitest run --config vitest.browser.config.ts",
    "test:integration": "node scripts/run-vitest-in-electron.mjs --config vitest.integration.config.ts",
    "test:electron-runtime": "node scripts/run-block-first-runtime-probes.mjs",
    "test:e2e": "pnpm run build && playwright test --config playwright.e2e.config.ts",
    "test:all": "pnpm run test && pnpm run test:browser && pnpm run test:electron-runtime && pnpm run test:e2e",
    "test:watch": "vitest --config vitest.node.config.ts",
    "test:renderer:watch": "vitest --config vitest.renderer.config.ts",
    "test:random": "vitest run --config vitest.node.config.ts --sequence.shuffle",
    "codex:schemas:generate": "tsx scripts/codex-schemas.ts generate",
    "codex:schemas:verify": "tsx scripts/codex-schemas.ts verify",
    "core:fmt": "cargo fmt --all --check",
    "core:clippy": "cargo clippy --workspace --all-targets --all-features -- -D warnings",
    "core:test": "cargo test --workspace --all-features",
    "core:build:mac:arm64": "cargo build --release --target aarch64-apple-darwin -p nodex-core-server -p nodex-cli && tsx scripts/stage-rust-core.ts --target-arch arm64 --out .generated/rust-core-runtime/arm64",
    "core:build:mac:x64": "cargo build --release --target x86_64-apple-darwin -p nodex-core-server -p nodex-cli && tsx scripts/stage-rust-core.ts --target-arch x64 --out .generated/rust-core-runtime/x64",
    "core:baseline:typescript": "NODEX_MEASURE_RUST_CORE_BASELINE=1 node scripts/run-vitest-in-electron.mjs --config vitest.main.config.ts src/main/rust-core-baseline.integration.test.ts",
    "core:probe:v82": "NODEX_GENERATE_RUST_CORE_V82_FIXTURE=1 node scripts/run-vitest-in-electron.mjs --config vitest.main.config.ts src/main/rust-core-v82-fixture.integration.test.ts && NODEX_V82_FIXTURE=.generated/rust-core-migration/v82-profile cargo test -p nodex-core --test v82_fixture_compatibility -- --ignored",
    "core:fixtures:yjs-yrs": "NODEX_GENERATE_YJS_YRS_FIXTURES=1 vitest run --config vitest.node.config.ts src/shared/block-documents/yjs-yrs-fixture-generator.test.ts",
    "core:authority:inventory": "tsx scripts/rust-core-authority-inventory.ts",
    "core:module-boundaries": "pnpm run core:authority:inventory && tsx scripts/audit-rust-core-boundaries.ts",
    "core:protocol:generate": "tsx scripts/core-protocol.ts generate",
    "core:protocol:verify": "tsx scripts/core-protocol.ts verify",
    "core:test:client": "cargo build -p nodex-core-server && vitest run --config vitest.node.config.ts src/main/core-client/core-client.node.test.ts src/main/core-client/sse-parser.node.test.ts",
    "sync:codex-theme": "pnpm run sync:codex-theme:contract && pnpm run sync:codex-theme:foundation && pnpm run sync:codex-theme:utilities && pnpm run sync:codex-theme:surface",
    "sync:codex-theme:contract": "tsx scripts/sync-codex-theme-contract.ts",
    "sync:codex-theme:foundation": "tsx scripts/sync-codex-theme-foundation.ts",
    "sync:codex-theme:utilities": "tsx scripts/sync-codex-theme-utilities.ts",
    "sync:codex-theme:surface": "tsx scripts/sync-codex-theme-surface.ts",
    "audit:codex-utility-contract": "tsx scripts/audit-codex-utility-contract.ts",
    "agent-tools:measure": "tsx scripts/measure-nodex-agent-tools.ts",
    "agent-tools:benchmark": "tsx scripts/run-nodex-agent-comprehension-benchmark.ts",
    "sync:icons": "tsx scripts/sync-app-icons.ts",
    "stage:codex-runtime:mac": "tsx scripts/stage-codex-runtime.ts --target-platform darwin --target-arch $(node -p \"process.arch\") --out .generated/codex-runtime",
    "stage:codex-runtime:mac:arm64": "tsx scripts/stage-codex-runtime.ts --target-platform darwin --target-arch arm64 --out .generated/codex-runtime",
    "stage:codex-runtime:mac:x64": "tsx scripts/stage-codex-runtime.ts --target-platform darwin --target-arch x64 --out .generated/codex-runtime",
    "dev:landing": "pnpm --filter @nodex/landing dev",
    "build:landing": "pnpm --filter @nodex/landing build",
    "preview:landing": "pnpm --filter @nodex/landing preview",
    "release:prepare": "tsx scripts/release-changelog.ts prepare --",
    "release:prepare:act": "bash scripts/run-prepare-release-act.sh",
    "release:prepare:act:list": "bash scripts/run-prepare-release-act.sh --list",
    "release:notes": "tsx scripts/release-changelog.ts extract --",
    "release:cask": "tsx scripts/generate-homebrew-cask.ts --",
    "release:download-aliases": "tsx scripts/release-download-aliases.ts --",
    "release:merge-mac-update-manifest": "tsx scripts/merge-mac-update-manifest.ts --",
    "release:cut": "tsx scripts/release-cut.ts --",
    "release:cut:patch": "pnpm run release:cut -- patch",
    "release:cut:minor": "pnpm run release:cut -- minor",
    "release:cut:major": "pnpm run release:cut -- major",
    "release:patch": "pnpm version patch --no-git-tag-version && pnpm run release:prepare",
    "release:minor": "pnpm version minor --no-git-tag-version && pnpm run release:prepare",
    "release:major": "pnpm version major --no-git-tag-version && pnpm run release:prepare",
    "dev": "pnpm --silent run stage:codex-runtime:mac && pnpm --silent run sync:icons && NODEX_SENTRY_ENABLED=true SENTRY_ENVIRONMENT=development SENTRY_RELEASE=nodex-dev electron-vite dev --logLevel warn --remoteDebuggingPort 9333",
    "build": "pnpm --silent run sync:icons && electron-vite build --logLevel warn",
    "build:run": "pnpm --silent run build && pnpm --silent run stage:codex-runtime:mac && electron . --remote-debugging-port=9333",
    "build:run:isolated": "bash scripts/run.sh",
    "package": "pnpm run package:mac",
    "package:mac": "pnpm run build && pnpm run stage:codex-runtime:mac && electron-builder --mac --publish never",
    "package:mac:arm64": "pnpm run build && pnpm run stage:codex-runtime:mac:arm64 && electron-builder --mac dmg zip --arm64 --publish never",
    "package:mac:x64": "pnpm run build && pnpm run stage:codex-runtime:mac:x64 && electron-builder --mac dmg zip --x64 --publish never",
    "package:all": "pnpm run build && pnpm run stage:codex-runtime:mac && electron-builder -mwl",
    "dev:storybook": "pnpm --filter @nodex/storybook storybook",
    "build:storybook": "pnpm --filter @nodex/storybook build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p packages/landing/tsconfig.json",
    "lint": "eslint src/ packages/storybook/.storybook/ packages/landing/vite.config.ts packages/landing/src/",
    "lint:tailwind:fix": "ESLINT_BETTER_TAILWIND=1 eslint src/ --fix",
    "postinstall": "electron-builder install-app-deps && node scripts/ensure-node-pty-permissions.mjs"
  },
  "dependencies": {
    "@hono/node-server": "2.0.5",
    "@sentry/electron": "7.13.0",
    "better-sqlite3": "12.11.1",
    "electron-updater": "6.8.9",
    "hono": "4.12.25",
    "immer": "11.1.8",
    "node-pty": "^1.1.0",
    "rrule": "2.8.1",
    "smol-toml": "1.6.1",
    "uuid": "14.0.0",
    "y-protocols": "1.0.7",
    "yjs": "13.6.31"
  },
  "devDependencies": {
    "@atlaskit/pragmatic-drag-and-drop": "2.0.0",
    "@atlaskit/pragmatic-drag-and-drop-auto-scroll": "3.0.0",
    "@blocknote/code-block": "workspace:*",
    "@blocknote/core": "workspace:*",
    "@blocknote/react": "workspace:*",
    "@blocknote/shadcn": "workspace:*",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@excalidraw/excalidraw": "0.18.1",
    "@floating-ui/react": "^0.27.19",
    "@nodex/codex-app-server-protocol": "workspace:*",
    "@nodex/core-protocol": "workspace:*",
    "@openai/codex": "0.144.6",
    "@openai/codex-darwin-arm64": "npm:@openai/codex@0.144.6-darwin-arm64",
    "@openai/codex-darwin-x64": "npm:@openai/codex@0.144.6-darwin-x64",
    "@pierre/diffs": "1.2.11",
    "@playwright/test": "1.61.1",
    "@radix-ui/react-collapsible": "1.1.16",
    "@radix-ui/react-context-menu": "2.3.3",
    "@radix-ui/react-dialog": "1.1.19",
    "@radix-ui/react-dropdown-menu": "2.1.20",
    "@radix-ui/react-hover-card": "1.1.19",
    "@radix-ui/react-popover": "1.1.19",
    "@radix-ui/react-scroll-area": "1.2.14",
    "@radix-ui/react-select": "2.3.3",
    "@radix-ui/react-slot": "1.3.0",
    "@radix-ui/react-tabs": "1.1.17",
    "@radix-ui/react-tooltip": "1.2.12",
    "@sentry/react": "10.50.0",
    "@sentry/vite-plugin": "5.3.0",
    "@statsig/js-client": "3.33.2",
    "@statsig/react-bindings": "3.33.2",
    "@statsig/web-analytics": "3.33.2",
    "@storybook/react-vite": "10.4.6",
    "@streamdown/cjk": "1.0.3",
    "@streamdown/code": "1.1.1",
    "@streamdown/math": "1.0.2",
    "@streamdown/mermaid": "1.0.2",
    "@tailwindcss/node": "4.3.1",
    "@tailwindcss/postcss": "4.3.1",
    "@tanstack/eslint-plugin-query": "^5.101.0",
    "@tanstack/form-core": "1.33.0",
    "@tanstack/react-form": "1.33.0",
    "@tanstack/react-query": "^5.101.0",
    "@tanstack/react-query-devtools": "^5.101.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@tiptap/core": "3.27.0",
    "@tiptap/extension-link": "3.27.0",
    "@tiptap/pm": "3.27.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "4.0.4",
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/browser-playwright": "4.1.10",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "agentation": "3.0.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "40.10.4",
    "electron-builder": "26.15.3",
    "electron-builder-squirrel-windows": "26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.1",
    "eslint": "10.5.0",
    "eslint-plugin-better-tailwindcss": "4.6.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jotai": "2.20.2",
    "js-yaml": "4.2.0",
    "jsdom": "29.1.1",
    "katex": "0.17.0",
    "lightningcss": "^1.32.0",
    "linkifyjs": "4.3.3",
    "lucide-react": "1.20.0",
    "mdast-util-from-markdown": "2.0.2",
    "mdast-util-to-string": "4.0.0",
    "minisearch": "7.2.0",
    "motion": "12.40.0",
    "openapi-typescript": "7.13.0",
    "playwright": "1.61.1",
    "prosemirror-highlight": "0.15.2",
    "prosemirror-view": "1.41.9",
    "react": "19.2.7",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.7",
    "remark-breaks": "^4.0.0",
    "streamdown": "2.5.0",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.1",
    "tldts": "7.4.3",
    "tsx": "4.23.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.61.1",
    "unified": "^11.0.5",
    "vite": "7.3.5",
    "vitest": "4.1.10",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=24.15.0 <25"
  }
}
